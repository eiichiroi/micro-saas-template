# このファイルを .env にコピーして値を入れる（.env は git に入れない）
# 値は空のままコミットする。実際のキーは絶対に書かない

# アプリ
APP_ENV=development
APP_URL=http://localhost:3000

# データベース
DATABASE_URL=

# 認証
AUTH_SECRET=

# Stripe（開発中は test キーを使う）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# メール送信
EMAIL_API_KEY=
EMAIL_FROM=

# エラー監視
SENTRY_DSN=
